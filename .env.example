# PostgreSQL
# Format : postgresql://user:password@host:5432/database
# Exemple local : postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Exemple Neon  : postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/wadacces?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign session cookies. Generate a strong one:
#   openssl rand -base64 48
# Example (DO NOT USE IN PRODUCTION, generate your own):
AUTH_SECRET=change-me-in-production

# Optional: store name override (defaults to "WadAcces")
# STORE_NAME=WadAcces

# Optional: enable verbose logging (1 = enabled)
# DEBUG=1
